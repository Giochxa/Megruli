<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- No culture-aware date/number formatting is needed (ka isn't in the small ICU
         subset anyway); resx satellite-assembly lookup works fine in invariant mode.
         PredefinedCulturesOnly=false is required so `new CultureInfo("en"/"ka")` doesn't
         throw under invariant mode — we only use the name for resource lookup, never for
         actual culture-specific formatting. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <SatelliteResourceLanguages>en;ka</SatelliteResourceLanguages>
    <DefaultLanguage>en</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.30" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="8.0.30" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!-- Shared/ holds the model classes (namespace Megruli.Shared) as plain source files rather
       than a separate project — this project is meant to be self-contained and uploadable as-is
       to a repo that only holds the app (see Shared/README.md for why, and the tradeoff). -->

</Project>
