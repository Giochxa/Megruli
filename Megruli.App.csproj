<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- InvariantGlobalization + PredefinedCulturesOnly=false was the smaller-payload option,
         but relying on PredefinedCulturesOnly actually working turned out to depend on the
         wasm-tools workload being installed at build time (it embeds that setting into the
         WASM output) — without it, `new CultureInfo("en"/"ka")` throws at startup and the app
         never boots. Full (non-invariant) globalization avoids that fragility entirely; the
         ICU data it adds is a small, worthwhile trade for the app reliably starting.
         Georgian ("ka") isn't in the default small ICU shard (EFIGS only), so full
         globalization data needs to be loaded explicitly for CultureInfo("ka") to work. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <SatelliteResourceLanguages>en;ka</SatelliteResourceLanguages>
    <DefaultLanguage>en</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.30" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="8.0.30" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!-- Shared/ holds the model classes (namespace Megruli.Shared) as plain source files rather
       than a separate project — this project is meant to be self-contained and uploadable as-is
       to a repo that only holds the app (see Shared/README.md for why, and the tradeoff). -->

</Project>
