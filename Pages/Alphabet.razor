@page "/alphabet"
@inject IStringLocalizer<SharedResource> Loc

<div class="alphabet-page">
    <h1>@Loc["Alphabet_Title"]</h1>
    <p class="intro">@Loc["Alphabet_Intro"]</p>

    <section class="info-card">
        <h2>@Loc["Alphabet_VowelsTitle"]</h2>
        <p>@Loc["Alphabet_VowelsP1"]</p>
        <p>@Loc["Alphabet_VowelsP2"]</p>
        <p>@Loc["Alphabet_VowelsP3"]</p>
        <div class="letter-card">
            <span class="letter-big">ჷ</span>
            <div class="letter-substitutes">
                <span class="letter-sub-label">@Loc["Alphabet_AcceptedWhenTyping"]</span>
                <span class="letter-chip">ი</span>
                <span class="letter-chip">უ</span>
                <span class="letter-chip">ო</span>
            </div>
        </div>
    </section>

    <section class="info-card">
        <h2>@Loc["Alphabet_ConsonantsTitle"]</h2>
        <p>@Loc["Alphabet_ConsonantsIntro"]</p>
        <ul>
            <li>@Loc["Alphabet_ConsonantY"]</li>
            <li>@Loc["Alphabet_ConsonantQ"]</li>
        </ul>
        <div class="letter-card">
            <span class="letter-big">ჸ</span>
            <div class="letter-substitutes">
                <span class="letter-sub-label">@Loc["Alphabet_AcceptedWhenTyping"]</span>
                <span class="letter-chip">ყ</span>
            </div>
        </div>
    </section>

    <section class="info-card">
        <h2>@Loc["Alphabet_TypingTitle"]</h2>
        <p>@Loc["Alphabet_TypingBody"]</p>
    </section>
</div>
