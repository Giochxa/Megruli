@page "/"
@inject ContentService Content
@inject ProgressService Progress
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc
@inject LocalizationService Localization

<div class="home-page">
    <div class="course-track-selector" role="group" aria-label="Course language">
        <button class="course-track-btn @(_courseLanguage == "ka" ? "active" : "")"
                @onclick='() => SelectCourseLanguage("ka")'>
            🇬🇪 @(Localization.IsGeorgian ? "მეგრული — ქართული" : "Megrelian — Georgian")
        </button>
        <button class="course-track-btn @(_courseLanguage == "en" ? "active" : "")"
                @onclick='() => SelectCourseLanguage("en")'>
            🇬🇧 @(Localization.IsGeorgian ? "მეგრული — ინგლისური" : "Megrelian — English")
        </button>
    </div>
    @if (_units is null)
    {
        <p class="loading">@Loc["Home_LoadingCourse"]</p>
    }
    else
    {
        @foreach (var unit in _units)
        {
            var primaryTitle = Localization.IsGeorgian ? unit.TitleGeorgian : unit.Title;
            var secondaryTitle = Localization.IsGeorgian ? unit.Title : unit.TitleGeorgian;
            var done = unit.Lessons.Count(l => Progress.IsLessonCompleted(l.Id));
            <section class="unit-section">
                <div class="unit-header">
                    <span class="unit-icon">@unit.Icon</span>
                    <div>
                        <h2>@primaryTitle</h2>
                        <span class="unit-subtitle">@secondaryTitle · @done/@unit.Lessons.Count</span>
                    </div>
                </div>
                <div class="lesson-path">
                    @foreach (var lesson in unit.Lessons)
                    {
                        var completed = Progress.IsLessonCompleted(lesson.Id);
                        <button class="lesson-node @(completed ? "lesson-done" : "") @LessonKindClass(lesson.Kind)"
                                title="@lesson.Title" @onclick="() => OpenLesson(lesson.Id)">
                            <span class="lesson-node-icon">@LessonIcon(lesson.Kind)</span>
                            @if (completed)
                            {
                                <span class="lesson-check">✓</span>
                            }
                        </button>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private List<CourseUnit>? _units;
    private string _courseLanguage = "ka";

    protected override async Task OnInitializedAsync()
    {
        await Progress.EnsureLoadedAsync();
        _courseLanguage = Localization.IsGeorgian ? "ka" : "en";
        await LoadUnitsAsync();
    }

    private async Task SelectCourseLanguage(string language)
    {
        if (_courseLanguage == language) return;
        _courseLanguage = language;
        await LoadUnitsAsync();
    }

    private async Task LoadUnitsAsync() => _units = _courseLanguage == "en"
        ? await Content.GetEnglishUnitsAsync()
        : await Content.GetUnitsAsync();

    private void OpenLesson(string lessonId) => Nav.NavigateTo($"/lesson/{lessonId}");

    private static string LessonKindClass(LessonKind kind) => kind switch
    {
        LessonKind.Grammar => "kind-grammar",
        LessonKind.Phrases => "kind-phrases",
        LessonKind.Listening => "kind-listening",
        LessonKind.Proverbs => "kind-proverbs",
        _ => "kind-vocab",
    };

    private static string LessonIcon(LessonKind kind) => kind switch
    {
        LessonKind.Grammar => "📐",
        LessonKind.Phrases => "💬",
        LessonKind.Listening => "🎧",
        LessonKind.Proverbs => "📜",
        _ => "📗",
    };
}
