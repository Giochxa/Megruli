@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Nav

<div class="report-control">
    <button type="button" class="report-btn" @onclick="ShareReport" title="@Loc["Lesson_Report"]">
        <span aria-hidden="true">⚑</span>
        <span>@Loc["Lesson_Report"]</span>
    </button>
    @if (_copied)
    {
        <span class="report-status" role="status">@Loc["Lesson_ReportCopied"]</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Content { get; set; } = "";

    private bool _copied;

    private async Task ShareReport()
    {
        _copied = false;
        var reportPath = $"lesson-report?content={Uri.EscapeDataString(Content)}";
        var reportUrl = new Uri(new Uri(Nav.BaseUri), reportPath).ToString();
        var result = await JS.InvokeAsync<string>("megruliReport.share", Title, Content, reportUrl);
        _copied = result == "copied";
    }
}
