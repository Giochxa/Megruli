@* Multiple-choice exercise: pick the correct translation among 2-4 options.
   Tapping an option answers immediately (no separate "Check" step) so there's
   nothing extra to find/press on a small screen. *@
@inject IStringLocalizer<SharedResource> Loc

<div class="exercise">
    <p class="exercise-instruction">@(Exercise.PromptIsGeorgian ? Loc["Exercise_SelectMegruli"] : Loc["Exercise_SelectGeorgian"])</p>
    <p class="exercise-prompt">
        @Exercise.Prompt
        @if (!Exercise.PromptIsGeorgian)
        {
            <PronounceButton WordId="Exercise.WordId" MegruliText="Exercise.Prompt" />
        }
    </p>

    <div class="option-grid">
        @for (int i = 0; i < Exercise.Options.Count; i++)
        {
            var idx = i;
            var cls = "option-btn";
            if (_answered)
            {
                if (idx == Exercise.CorrectIndex) cls += " option-correct";
                else if (idx == _selected) cls += " option-wrong";
            }
            <div class="option-cell">
                <button class="@cls" disabled="@_answered" @onclick="() => Select(idx)">@Exercise.Options[idx]</button>
                @if (Exercise.PromptIsGeorgian)
                {
                    <PronounceButton MegruliText="Exercise.Options[idx]" />
                }
            </div>
        }
    </div>

    @if (_answered)
    {
        <ExerciseFooter CanCheck="true" Answered="true" Correct="_correct" OnContinue="Continue" />
    }
</div>

@code {
    [Parameter, EditorRequired] public MultipleChoiceExercise Exercise { get; set; } = default!;
    [Parameter] public EventCallback<bool> OnComplete { get; set; }

    private int? _selected;
    private bool _answered;
    private bool _correct;

    private void Select(int idx)
    {
        if (_answered) return;
        _selected = idx;
        _correct = idx == Exercise.CorrectIndex;
        _answered = true;
    }

    private async Task Continue()
    {
        await OnComplete.InvokeAsync(_correct);
    }
}
