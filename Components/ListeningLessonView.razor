@* Full-length lesson recording player, plus any labeled short clips pulled from it. *@
@inject ContentService Content
@inject AudioClipLabelService Labels
@inject ProgressService Progress
@inject IStringLocalizer<SharedResource> Loc
@inject LocalizationService Localization

<div class="listening-lesson">
    <div class="lesson-header">
        <button class="close-btn" @onclick="() => OnDone.InvokeAsync()">✕</button>
        <h2>@Lesson.Title</h2>
    </div>

    <div class="lesson-report-row">
        <ReportButton Title="@Loc["Lesson_ReportTitle"]" Content="@BuildReport()" />
    </div>

    @if (Lesson.LessonAudioFile is not null)
    {
        <div class="listening-player">
            <p>@Loc["Listening_Intro"]</p>
            <audio controls src="@($"audio/lessons/{Lesson.LessonAudioFile}")" style="width:100%"></audio>
        </div>
    }

    @if (_labeledClips.Count > 0)
    {
        <h3>@Loc["Listening_LabeledMoments"]</h3>
        <ul class="clip-list">
            @foreach (var (clip, label) in _labeledClips)
            {
                <li class="clip-row">
                    <button class="play-btn small" @onclick="() => Play(clip.Id)">🔊</button>
                    <audio id="@AudioElementId(clip.Id)" src="@($"audio/lessons/{clip.SourceFile}")" preload="metadata"></audio>
                    <span class="clip-megruli">@DisplayMegruli(label.Megruli)</span>
                    <span class="clip-georgian">@label.Georgian</span>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="hint">@Loc["Listening_NoLabels"]</p>
    }

    <button class="btn btn-continue" @onclick="Complete">@Loc["Listening_MarkListened"]</button>
</div>

@code {
    [Parameter, EditorRequired] public Lesson Lesson { get; set; } = default!;
    [Parameter] public EventCallback OnDone { get; set; }
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<(Megruli.Shared.AudioClip Clip, Megruli.Shared.AudioClipLabel Label)> _labeledClips = new();

    protected override async Task OnParametersSetAsync()
    {
        _labeledClips.Clear();
        if (Lesson.LessonAudioFile is null) return;

        var clips = await Content.GetClipsForSourceAsync(Lesson.LessonAudioFile);
        var allLabels = await Labels.GetAllAsync();
        foreach (var clip in clips)
        {
            if (allLabels.TryGetValue(clip.Id, out var label) &&
                AudioClipLabelService.IsUsableMegruli(label) &&
                !string.IsNullOrWhiteSpace(label.Megruli))
            {
                _labeledClips.Add((clip, label));
            }
        }
    }

    private async Task Play(string clipId)
    {
        var clip = _labeledClips.FirstOrDefault(item => item.Clip.Id == clipId).Clip;
        if (clip is not null)
        {
            await JS.InvokeVoidAsync("megruliAudio.playSegmentById", AudioElementId(clipId), clip.StartMs, clip.EndMs);
        }
    }

    private static string AudioElementId(string clipId) => $"listening-audio-{clipId}";

    private string? DisplayMegruli(string? text) => Localization.IsGeorgian || text is null
        ? text
        : MegrelianTransliterator.ToLatin(text);

    private async Task Complete()
    {
        await Progress.CompleteLessonAsync(Lesson.Id, 5);
        await OnDone.InvokeAsync();
    }

    private string BuildReport() => string.Join(Environment.NewLine,
        Loc["Lesson_ReportHeading"].Value,
        $"{Loc["Lesson_ReportLesson"]}: {Lesson.Title} ({Lesson.Id})",
        $"{Loc["Lesson_ReportAudio"]}: {Lesson.LessonAudioFile ?? "—"}");
}
